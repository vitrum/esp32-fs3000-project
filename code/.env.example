# Optional Wi-Fi fallback; saved device networks take precedence.
WIFI_SSID=
WIFI_PASSWORD=

# Future IoT client settings; no service is connected automatically.
IOT_ENDPOINT=
IOT_DEVICE_ID=
IOT_USERNAME=
IOT_PASSWORD=
IOT_TOKEN=

# Device uploads use an HTTPS signing service or a short-lived signed URL.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_REGION=
OSS_FIT_PREFIX=fit/
OSS_SIGN_URL_ENDPOINT=
OSS_FIT_UPLOAD_URL=

# Optional host/backend credentials. Never embedded in ESP32 firmware.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=

# Reserved download/verification settings, not an enabled OTA updater.
FIRMWARE_MANIFEST_URL=
FIRMWARE_DOWNLOAD_URL=
FIRMWARE_EXPECTED_SHA256=